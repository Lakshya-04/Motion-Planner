* text=auto eol=lf

# Binary assets — never diff or merge these
*.stl        binary
*.dae        binary
*.STL        binary
*.png        binary
*.jpg        binary
*.pgm        binary
*.mcap       binary
*.db3        binary
*.pt         binary
*.onnx       binary
*.pcd        binary
# Large mesh assets belong in git-lfs. Enable with: git lfs install
*.stl        filter=lfs diff=lfs merge=lfs -text
*.STL        filter=lfs diff=lfs merge=lfs -text
*.pcd        filter=lfs diff=lfs merge=lfs -text
# *.dae      filter=lfs diff=lfs merge=lfs -text
# Generated files: collapse in review, exclude from language stats
src/manipulation/moveit_config/** linguist-generated=true
docs/diagrams/*.svg                   linguist-generated=true
*.stl filter=lfs diff=lfs merge=lfs -text
