* text=auto eol=lf

# Binary assets — never diff or merge these
*.stl        binary
*.dae        binary
*.STL        binary
*.png        binary
*.jpg        binary
*.pgm        binary
*.mcap       binary
*.db3        binary
*.pt         binary
*.onnx       binary
*.pcd        binary
# No git-lfs: fixtures are stored as plain files (GitHub LFS has a small free quota and a clone without
# git-lfs gets pointer files instead of data). Keep tracked binaries small; larger data is downloaded by a script.
# *.dae      filter=lfs diff=lfs merge=lfs -text
# Generated files: collapse in review, exclude from language stats
src/manipulation/moveit_config/** linguist-generated=true
docs/diagrams/*.svg                   linguist-generated=true

# Append-only logs: parallel branches that each add a line must not conflict (keeps both sides)
CHANGELOG.md merge=union
