# Manifest for docker/tools/run_host_core_tests.sh: the ROS-free C++ cores and their gtests, built with plain g++
# (no ROS, no colcon). Paths are relative to the repository root; the tests run with the root as working directory.
#
#   lib     | name | include dir | sources (space separated) | dependency libs | extra link flags
#   test    | name | libs        | test source               | extra compile flags (eval'ed, may carry quoted -D)
#   exclude | test source | reason       (not built; reported as EXCLUDED)
#
# A test is listed only if it includes nothing but std, Eigen, yaml-cpp, nlohmann_json, gtest and headers of the
# packages above. Anything that needs rclcpp, *_msgs, MoveIt, pluginlib, PCL, octomap, ament, hardware or a
# simulator is excluded with the reason. Apt packages needed: g++ libgtest-dev libeigen3-dev libyaml-cpp-dev libtinyxml2-dev
# nlohmann-json3-dev libtinyxml2-dev.
lib | core_types | src/common/core_types/include |  |  | 
lib | tool_calibration | src/common/tool_calibration/include |  | core_types | 
lib | ros_adapters | src/common/ros_adapters/include |  | core_types | -lyaml-cpp
lib | force_core | src/common/force_core/include | src/common/force_core/src/bias_tracker.cpp src/common/force_core/src/contact_free_gate.cpp src/common/force_core/src/force_limiter.cpp src/common/force_core/src/force_stage_fsm.cpp src/common/force_core/src/force_stage_sequencer.cpp src/common/force_core/src/payload_excitation.cpp src/common/force_core/src/wrench_conditioning.cpp | core_types | -pthread
