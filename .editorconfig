root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{c,cc,cpp,h,hpp}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 99

[*.{yaml,yml,xml,urdf,xacro,sdf,launch}]
indent_size = 2

[*.{md,rst}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
