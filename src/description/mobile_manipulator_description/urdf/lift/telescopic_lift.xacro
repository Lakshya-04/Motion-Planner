<?xml version="1.0"?>
<!-- Parametric telescopic lift column: one controlled master prismatic joint (full stroke) that
     carries the arm, and 0..3 visual/collision stages that follow it through <mimic> joints, each
     moving stroke/stages relative to the stage below. Only `lift_joint` is commanded.

     Contract (what a replacement lift must provide):
       link  `${prefix}lift_base_link`    fixed to the parent
       joint `${prefix}lift_joint`        prismatic, axis +z, lower 0, upper `stroke`
       link  `${prefix}lift_output_link`  the arm attaches here (moves with lift_joint)
     Mimic stage joints are optional and are not commanded.

     Geometry (primitives only). By default every stage is a cylinder as tall as the column. A real
     column can be described instead with these optional arguments (all empty = the default):
       shape          cylinder | box   shape of the stage tubes (the fixed column and carriage are boxes)
       column_size    "x y h"          outer cross-section and height of the fixed column
       stage_sizes    "x y h ..."      one triple per stage, outermost first (outer cross-section, height)
       stage_rest_z   "z1 z2 ..."      bottom of each stage above the bottom of the fixed column, retracted
       carriage_size  "x y z"          the plate on the last stage
     With stage_sizes the stack must be continuous: stage_rest_z and stage_sizes are given for every
     stage, each stage is narrower than the one below, and the top of the last stage (rest z + height)
     is where the carriage sits, `column_height`. A description that breaks this fails to render. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One telescoping stage link + its mimic joint. `index` is 1-based, `of` is the stage count.
       `sx sy sz` is the tube's outer size (a cylinder takes radius sx / 2); `rest_dz` is its bottom
       above the bottom of the stage below when retracted. -->
  <xacro:macro name="lift_stage" params="prefix index of stroke parent_link shape sx sy sz rest_dz:=0 fixed_height:=''">
    <link name="${prefix}lift_stage_${index}_link">
      <visual>
        <origin xyz="0 0 ${sz / 2.0}" rpy="0 0 0"/>
        <geometry>
          <xacro:if value="${shape == 'box'}"><box size="${sx} ${sy} ${sz}"/></xacro:if>
          <xacro:unless value="${shape == 'box'}"><cylinder radius="${sx / 2.0}" length="${sz}"/></xacro:unless>
        </geometry>
        <material name="lift_silver"><color rgba="0.7 0.72 0.75 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${sz / 2.0}" rpy="0 0 0"/>
        <geometry>
          <xacro:if value="${shape == 'box'}"><box size="${sx} ${sy} ${sz}"/></xacro:if>
          <xacro:unless value="${shape == 'box'}"><cylinder radius="${sx / 2.0}" length="${sz}"/></xacro:unless>
        </geometry>
      </collision>
      <inertial><mass value="2.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.01"/></inertial>
    </link>
    <xacro:if value="${fixed_height == ''}">
      <joint name="${prefix}lift_stage_${index}_joint" type="prismatic">
        <parent link="${parent_link}"/>
        <child link="${prefix}lift_stage_${index}_link"/>
        <origin xyz="0 0 ${rest_dz}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="${stroke / of}" effort="1000" velocity="1.0"/>
        <mimic joint="${prefix}lift_joint" multiplier="${1.0 / of}" offset="0"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${fixed_height == ''}">
      <joint name="${prefix}lift_stage_${index}_joint" type="fixed">
        <parent link="${parent_link}"/>
        <child link="${prefix}lift_stage_${index}_link"/>
        <origin xyz="0 0 ${rest_dz + float(fixed_height) / of}" rpy="0 0 0"/>
      </joint>
    </xacro:unless>
  </xacro:macro>

  <xacro:macro name="telescopic_lift" params="parent *origin prefix:='' stroke:=1.5 stages:=2 max_velocity:=0.2 max_effort:=2000.0 column_height:=0.8 column_width:=0.18 arm_mount_xyz:='0 0 0.02' arm_mount_rpy:='0 0 0' fixed_height:='' shape:='cylinder' column_size:='' stage_sizes:='' stage_rest_z:='' carriage_size:=''">

    <xacro:property name="n_stages" value="${int(stages)}"/>
    <xacro:property name="explicit" value="${stage_sizes != ''}"/>
    <!-- The fixed column and the carriage: given sizes, else the legacy ones. -->
    <xacro:property name="col" value="${[float(v) for v in str(column_size).split()] if column_size != '' else [column_width, column_width, column_height]}"/>
    <xacro:property name="car" value="${[float(v) for v in str(carriage_size).split()] if carriage_size != '' else [column_width * 1.4, column_width * 1.4, 0.04]}"/>
    <!-- Per stage [x, y, h, rest_dz], outermost first (3 slots; the unused ones are never rendered). -->
    <xacro:property name="sz_list" value="${[float(v) for v in str(stage_sizes).split()] if explicit else []}"/>
    <xacro:property name="rz_list" value="${[float(v) for v in str(stage_rest_z).split()] if explicit else []}"/>
    <xacro:property name="st" value="${[[sz_list[3 * i], sz_list[3 * i + 1], sz_list[3 * i + 2], rz_list[i] - (rz_list[i - 1] if i > 0 else 0.0)] if explicit and len(sz_list) > 3 * i + 2 and len(rz_list) > i else [[2 * column_width * 0.4, 2 * column_width * 0.4, column_height, 0], [2 * column_width * 0.32, 2 * column_width * 0.32, column_height, 0], [2 * column_width * 0.25, 2 * column_width * 0.25, column_height, 0]][i] for i in range(3)]}"/>

    <!-- A stage list that does not describe a continuous column fails loudly instead of rendering. -->
    <xacro:if value="${explicit and (len(sz_list) != 3 * n_stages or len(rz_list) != n_stages)}">
      <xacro:if value="${dict()['lift stage geometry: stage_sizes needs 3 numbers and stage_rest_z 1 number per stage (stages=' + str(n_stages) + ')']}"/>
    </xacro:if>
    <xacro:if value="${explicit and n_stages >= 1 and len(sz_list) == 3 * n_stages and len(rz_list) == n_stages and fabs(rz_list[n_stages - 1] + sz_list[3 * n_stages - 1] - column_height) > 1e-6}">
      <xacro:if value="${dict()['lift stage geometry is not continuous: the top of the last stage (rest z + height) must equal the stack height (mount height - arm mount z)']}"/>
    </xacro:if>
    <xacro:if value="${explicit and n_stages >= 1 and len(sz_list) == 3 * n_stages and len(rz_list) == n_stages and len([i for i in range(n_stages) if sz_list[3 * i] >= (col[0] if i == 0 else sz_list[3 * i - 3]) or sz_list[3 * i + 1] >= (col[1] if i == 0 else sz_list[3 * i - 2])]) > 0}">
      <xacro:if value="${dict()['lift stage geometry: every stage must be narrower than the one below it']}"/>
    </xacro:if>

    <!-- Fixed outer column. -->
    <link name="${prefix}lift_base_link">
      <visual>
        <origin xyz="0 0 ${col[2] / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${col[0]} ${col[1]} ${col[2]}"/></geometry>
        <material name="lift_dark"><color rgba="0.25 0.27 0.3 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${col[2] / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${col[0]} ${col[1]} ${col[2]}"/></geometry>
      </collision>
      <inertial><mass value="10.0"/><inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.1"/></inertial>
    </link>
    <joint name="${prefix}lift_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}lift_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Moving carriage: driven by the single master joint over the full stroke. It sits at the
         top of the fixed column when the lift is retracted. -->
    <link name="${prefix}lift_carriage_link">
      <visual>
        <origin xyz="0 0 ${car[2] / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${car[0]} ${car[1]} ${car[2]}"/></geometry>
        <material name="lift_plate"><color rgba="0.55 0.57 0.6 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${car[2] / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${car[0]} ${car[1]} ${car[2]}"/></geometry>
      </collision>
      <inertial><mass value="3.0"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
    </link>
    <xacro:if value="${fixed_height == ''}">
      <joint name="${prefix}lift_joint" type="prismatic">
        <parent link="${prefix}lift_base_link"/>
        <child link="${prefix}lift_carriage_link"/>
        <origin xyz="0 0 ${column_height}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="${stroke}" effort="${max_effort}" velocity="${max_velocity}"/>
      </joint>
    </xacro:if>
    <!-- `fixed_height` pins the lift (and its stages) at that extension: an arm-only robot, e.g. for
         a 6-DOF VAMP model while the lift is parked. -->
    <xacro:unless value="${fixed_height == ''}">
      <joint name="${prefix}lift_joint" type="fixed">
        <parent link="${prefix}lift_base_link"/>
        <child link="${prefix}lift_carriage_link"/>
        <origin xyz="0 0 ${column_height + float(fixed_height)}" rpy="0 0 0"/>
      </joint>
    </xacro:unless>

    <!-- Optional telescoping stages that follow the master joint (visual / collision only). -->
    <xacro:if value="${n_stages >= 1}">
      <xacro:lift_stage prefix="${prefix}" index="1" of="${n_stages}" stroke="${stroke}" shape="${shape}"
        parent_link="${prefix}lift_base_link" sx="${st[0][0]}" sy="${st[0][1]}" sz="${st[0][2]}" rest_dz="${st[0][3]}" fixed_height="${fixed_height}"/>
    </xacro:if>
    <xacro:if value="${n_stages >= 2}">
      <xacro:lift_stage prefix="${prefix}" index="2" of="${n_stages}" stroke="${stroke}" shape="${shape}"
        parent_link="${prefix}lift_stage_1_link" sx="${st[1][0]}" sy="${st[1][1]}" sz="${st[1][2]}" rest_dz="${st[1][3]}" fixed_height="${fixed_height}"/>
    </xacro:if>
    <xacro:if value="${n_stages >= 3}">
      <xacro:lift_stage prefix="${prefix}" index="3" of="${n_stages}" stroke="${stroke}" shape="${shape}"
        parent_link="${prefix}lift_stage_2_link" sx="${st[2][0]}" sy="${st[2][1]}" sz="${st[2][2]}" rest_dz="${st[2][3]}" fixed_height="${fixed_height}"/>
    </xacro:if>

    <!-- Where the arm attaches. -->
    <link name="${prefix}lift_output_link"/>
    <joint name="${prefix}lift_output_joint" type="fixed">
      <parent link="${prefix}lift_carriage_link"/>
      <child link="${prefix}lift_output_link"/>
      <origin xyz="${arm_mount_xyz}" rpy="${arm_mount_rpy}"/>
    </joint>
  </xacro:macro>
</robot>
