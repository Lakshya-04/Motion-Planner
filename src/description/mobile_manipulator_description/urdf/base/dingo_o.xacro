<?xml version="1.0"?>
<!-- Clearpath Dingo-O: four mecanum wheels (omnidirectional), small indoor base.
     Primitive model from nominal published dimensions (approximate, from memory of the public
     spec sheets: check every default against your unit and override through the macro parameters;
     no vendor mesh).  Wheels are fixed links: the base is driven by its vehicle controller, not
     by the planner. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find mobile_manipulator_description)/urdf/base/wheeled_base_common.xacro"/>
  <xacro:macro name="dingo_o_base" params="prefix:='' length:=0.506 width:=0.4 height:=0.12 ground_clearance:=0.052 mass:=17.0 rgba:='0.2 0.2 0.25 1' wheel_radius:=0.05 wheel_width:=0.06 track:=0.404 wheelbase:=0.3 mount_x:=0.0 mount_y:=0.0">
    <xacro:four_wheel_base prefix="${prefix}"
    length="${length}"
    width="${width}"
    height="${height}"
    ground_clearance="${ground_clearance}"
    mass="${mass}"
    rgba="${rgba}"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    track="${track}"
    wheelbase="${wheelbase}"
    mount_x="${mount_x}" mount_y="${mount_y}"/>
  </xacro:macro>
</robot>
