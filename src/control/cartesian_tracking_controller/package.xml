<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cartesian_tracking_controller</name>
  <version>0.1.0</version>
  <description>
    Chainable ros2_control controller that tracks a Cartesian contact-point pose reference with
    joint velocity commands. A thin plugin around diff_ik_core::CartesianTracker: the flange
    Jacobian and pose come from kinematics_interface (KDL), the tool offset can be swapped at run
    time, and a plane servo can hold a wall standoff.
  </description>
  <maintainer email="100lakshyaagarwal@gmail.com">Lakshya Agarwal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>diff_ik_core</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>kinematics_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>std_msgs</depend>
  <depend>urdf</depend>

  <!-- The KDL plugin is loaded by name at configure time. -->
  <exec_depend>kinematics_interface_kdl</exec_depend>
  <test_depend>kinematics_interface_kdl</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
