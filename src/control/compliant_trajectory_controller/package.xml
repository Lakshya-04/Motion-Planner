<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>compliant_trajectory_controller</name>
  <version>0.0.0</version>
  <description>
    Fused joint-trajectory + admittance controller for the 7-DOF arm+lift chain: follows a planned
    joint trajectory while overlaying a bounded, force-driven Cartesian compliance offset, and can
    freeze trajectory time until a commanded contact force converges. Referred to as "JTAC" in
    discussion, after MoveIt Pro's equivalent (whose implementation is closed-source; this shares
    the architecture, not the code). Reuses ros2_control's maintained admittance_controller
    AdmittanceRule for the compliance law rather than reimplementing it.
  </description>
  <maintainer email="100lakshyaagarwal@gmail.com">Lakshya Agarwal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>admittance_controller</depend>
  <depend>ament_index_cpp</depend>
  <depend>control_msgs</depend>
  <depend>controller_interface</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>kinematics_interface</depend>
  <depend>core_types</depend>
  <depend>force_core</depend>
  <depend>ros_adapters</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>octomap</depend>
  <depend>octomap_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- The KDL kinematics plugin is resolved at runtime by name; the demo node and the
       integration test both load it. -->
  <exec_depend>kinematics_interface_kdl</exec_depend>
  <test_depend>kinematics_interface_kdl</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <!-- Live RViz demo (jtac_compliance_demo.launch.py): not build dependencies, only launched.
       The robot description package for the real robot chain is supplied by the user's own
       workspace, so it is intentionally not declared here. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- jtac_controller_test.launch.py: runs JtacController under a real controller_manager, with
       a mock F/T sensor injected via ft_bridge_hardware. -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ft_bridge_hardware</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
