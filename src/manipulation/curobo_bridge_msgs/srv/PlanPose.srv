# Collision-free move to a tool pose (robot base frame), from a joint state.
float64[] start
geometry_msgs/Pose goal
---
bool success
string failure_reason_code
string failure_stage
string message
# how the trajectory was made: trajopt (optimised) | graph_seed (validated graph path, NOT optimised) | empty on failure
string route
trajectory_msgs/JointTrajectory trajectory
float64 planning_time_s
# where the time went (0 when the planner did not measure): cuRobo attempts on the main call, graph-planner
# calls and their solve time, wall time of the whole request. planning_time_s can read far under wall_s.
uint32 attempts
uint32 graph_calls
float64 graph_solve_s
float64 wall_s
