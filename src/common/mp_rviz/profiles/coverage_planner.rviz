# generated once; edit freely. See docs/rviz/perception_coverage_reach.md
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 400
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - /Current View1
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Plane Cell Count: 10
    Cell Size: 1
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Names: true
  - Class: rviz_default_plugins/Map
    Name: Input map (/map)
    Enabled: true
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
  - Class: rviz_default_plugins/Map
    Name: Trial map (/trial_map)
    Enabled: false
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trial_map
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trial_map_updates
  - Class: rviz_default_plugins/Path
    Name: Coverage path (coverage_planner_node)
    Enabled: true
    Color: 0; 255; 0
    Line Style: Lines
    Line Width: 0.03
    Pose Style: Axes
    Pose Color: 255; 128; 0
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /coverage_planner_node/coverage_path
  - Class: rviz_default_plugins/MarkerArray
    Name: Coverage markers
    Enabled: true
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /coverage_planner_node/coverage_markers
  - Class: rviz_default_plugins/Map
    Name: Coverage grid (demo)
    Enabled: false
    Alpha: 0.7
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/coverage_grid
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/coverage_grid_updates
  - Class: rviz_default_plugins/Path
    Name: Flat path (demo)
    Enabled: false
    Color: 0; 160; 255
    Line Style: Lines
    Line Width: 0.03
    Pose Style: Axes
    Pose Color: 255; 128; 0
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/flat_coverage_path
  - Class: rviz_default_plugins/Path
    Name: Final path (demo)
    Enabled: false
    Color: 0; 255; 0
    Line Style: Lines
    Line Width: 0.03
    Pose Style: Axes
    Pose Color: 255; 128; 0
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/final_coverage_path
  - Class: rviz_default_plugins/Marker
    Name: Flat coverage lines (demo)
    Enabled: false
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/flat_coverage_lines
  - Class: rviz_default_plugins/Marker
    Name: Final coverage lines (demo)
    Enabled: false
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/final_coverage_lines
  - Class: rviz_default_plugins/MarkerArray
    Name: Final markers (demo)
    Enabled: false
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/final_coverage_markers
  - Class: rviz_default_plugins/PointCloud2
    Name: Wall Point Cloud (demo, ground truth)
    Enabled: false
    Style: Points
    Size (Pixels): 2
    Size (m): 0.01
    Color Transformer: FlatColor
    Color: 200; 200; 200
    Position Transformer: XYZ
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/wall_point_cloud
  - Class: rviz_default_plugins/MarkerArray
    Name: Obstacle Regions 2D
    Enabled: false
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/obstacle_markers
  - Class: rviz_default_plugins/MarkerArray
    Name: Obstacle Boxes 3D
    Enabled: false
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /wall_coverage_demo/obstacle_box_markers
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.75
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Width: 1200
  X: 60
  Y: 40
