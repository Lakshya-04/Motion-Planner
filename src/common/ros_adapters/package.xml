<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros_adapters</name>
  <version>0.1.0</version>
  <description>
    Generic ROS-backed implementations of core_types ports (Logger, Pose
    conversions, and similar) shared across the ROS adapter packages
    (motion_planner, coverage_planner, etc.) so each one doesn't
    duplicate or depend on another just to reuse them.
  </description>
  <maintainer email="100lakshyaagarwal@gmail.com">Lakshya Agarwal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>core_types</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
