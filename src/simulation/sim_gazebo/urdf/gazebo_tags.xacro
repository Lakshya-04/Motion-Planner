<?xml version="1.0"?>
<!-- Gazebo-only tags, pulled in by mobile_manipulator.ros2_control.xacro for hardware:=gazebo.
       - the robot is pinned to the world (a static base; wall pushes must not move it)
       - gz_ros2_control plugin with the controller_manager parameters
       - ft_sensor_link: the F/T sensor body between the arm flange and the tool (same pose as the
         flange, so the kinematics equal the other backends); the tool hangs behind it, offset by
         tcp_xyz along the tool axis
       - force_torque sensor `ft_sensor` on ft_sensor_joint, raw, in the sensor frame
       - contact sensor on the tool collision (ground truth contact wrench, evaluation only)

     F/T sign convention (documented in docs/sim_gazebo.md): frame = child (ft_sensor_link) and
     measure_direction = child_to_parent, i.e. the reading is what the tool side exerts on the arm
     side. At rest it is the weight of everything beyond the sensor (sensor body + tool); in
     contact it adds the force the environment exerts on the tool (statics: f_reading = f_env + m g).
     Nothing is compensated or moved to the tcp here.

     gz_base_motion:=true (launch arg base_motion:=true) frees the base: no world joint, the model gets gz-sim's
     VelocityControl (Twist on /cmd_vel, planar) and OdometryPublisher (odom and TF odom -> base_footprint)
     systems, and a thin low-friction skid under the base (the wheels are visual only) holds it on the floor.
     Off by default: the output is then identical to before.

     gz_depth_sensor:=true (launch arg depth_sensor:=true) adds the link depth_sensor_link on base_footprint
     (gz_depth_xyz / gz_depth_rpy, x forward) with a gz-sim depth_camera (96 x 64, 60 degrees, 0.1 to 5 m, optional
     Gaussian range noise) that publishes gz PointCloud2 on /depth_sensor/points; the launch file adds the Sensors
     system to the world. Off by default.

     gz_lidar:=true (launch arg lidar:=true) adds the link lidar_link on base_footprint (gz_lidar_xyz / gz_lidar_rpy,
     x forward) with a gz-sim gpu_lidar (gz_lidar_samples rays from gz_lidar_min_angle to gz_lidar_max_angle, range
     gz_lidar_min to gz_lidar_max, gz_lidar_rate Hz, optional Gaussian range noise) that publishes gz LaserScan on /scan;
     the launch file adds the Sensors system to the world and bridges it to sensor_msgs/LaserScan. Off by default.

     gz_rgb_camera:=true (launch arg rgb_camera:=true) adds the link rgb_camera_link on base_footprint (gz_rgb_xyz /
     gz_rgb_rpy, x forward) with a gz-sim colour camera (gz_rgb_width x gz_rgb_height, 60 degrees, 0.05 to 20 m,
     gz_rgb_rate Hz) that publishes gz Image on /rgb_camera/image; the launch file adds the Sensors system to the
     world and bridges it to sensor_msgs/Image. For stills of a run (capture_still.py); not part of the control loop.
     Off by default. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="gz_base_motion" default="false"/>
  <xacro:arg name="gz_extra_params" default=""/>
  <xacro:arg name="gz_depth_sensor" default="false"/>
  <xacro:arg name="gz_depth_xyz" default="0.1 0 1.15"/>
  <xacro:arg name="gz_depth_rpy" default="0 0 0"/>
  <xacro:arg name="gz_depth_noise" default="0.0"/>
  <xacro:arg name="gz_depth_rate" default="5.0"/>
  <xacro:arg name="gz_lidar" default="false"/>
  <xacro:arg name="gz_lidar_xyz" default="0.45 0 0.2"/>
  <xacro:arg name="gz_lidar_rpy" default="0 0 0"/>
  <xacro:arg name="gz_lidar_samples" default="541"/>
  <xacro:arg name="gz_lidar_min_angle" default="-2.35619449"/>
  <xacro:arg name="gz_lidar_max_angle" default="2.35619449"/>
  <xacro:arg name="gz_lidar_min" default="0.05"/>
  <xacro:arg name="gz_lidar_max" default="10.0"/>
  <xacro:arg name="gz_lidar_rate" default="10.0"/>
  <xacro:arg name="gz_lidar_noise" default="0.0"/>
  <xacro:arg name="gz_rgb_camera" default="false"/>
  <xacro:arg name="gz_rgb_xyz" default="0.0 -2.4 1.6"/>
  <xacro:arg name="gz_rgb_rpy" default="0 0.11 1.38"/>
  <xacro:arg name="gz_rgb_width" default="1280"/>
  <xacro:arg name="gz_rgb_height" default="720"/>
  <xacro:arg name="gz_rgb_rate" default="2.0"/>
  <xacro:macro name="sim_gazebo_tags" params="sensor_mass:=0.3 sensor_com_z:=0.02 sensor_radius:=0.04 sensor_length:=0.04 tool_mu:=0.8 tip_stiffness:=5000.0 tip_damping:=100.0 tip_travel:=0.02 tip_length:=0.1 tip_radius:=0.04 stop_stiffness:=50000.0 stop_damping:=500.0 stop_travel:=0.005">
    <xacro:unless value="${'$(arg gz_base_motion)' == 'true'}">
      <link name="world"/>
      <joint name="sim_world_joint" type="fixed">
        <parent link="world"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:unless>
    <xacro:if value="${'$(arg gz_base_motion)' == 'true'}">
      <!-- The base box floats 5 cm above the floor (the footprint frame is on the floor): a flat skid
           under it keeps the base at the right height and upright. Fixed joint, so it is lumped into base_link. -->
      <link name="base_skid_link">
        <collision>
          <origin xyz="0 0 0.025" rpy="0 0 0"/>
          <geometry><box size="0.8 0.5 0.05"/></geometry>
        </collision>
        <inertial>
          <origin xyz="0 0 0.025" rpy="0 0 0"/>
          <mass value="1.0"/>
          <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
        </inertial>
      </link>
      <joint name="base_skid_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_skid_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
      <gazebo reference="base_skid_link">
        <mu1>0.02</mu1>
        <mu2>0.02</mu2>
      </gazebo>
      <gazebo>
        <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
          <topic>/base/cmd_vel</topic>
        </plugin>
        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
          <odom_frame>odom</odom_frame>
          <robot_base_frame>base_footprint</robot_base_frame>
          <dimensions>2</dimensions>
          <odom_publish_frequency>50</odom_publish_frequency>
          <odom_topic>/base/odom</odom_topic>
          <tf_topic>/base/tf</tf_topic>
        </plugin>
      </gazebo>
    </xacro:if>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find sim_gazebo)/config/controllers.yaml</parameters>
        <xacro:if value="${'$(arg gz_extra_params)' != ''}"><parameters>$(arg gz_extra_params)</parameters></xacro:if>
      </plugin>
    </gazebo>

    <xacro:if value="${'$(arg gz_depth_sensor)' == 'true'}">
      <link name="depth_sensor_link"/>
      <joint name="depth_sensor_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="depth_sensor_link"/>
        <origin xyz="$(arg gz_depth_xyz)" rpy="$(arg gz_depth_rpy)"/>
      </joint>
      <gazebo reference="depth_sensor_link">
        <sensor name="depth_sensor" type="depth_camera">
          <always_on>true</always_on>
          <update_rate>$(arg gz_depth_rate)</update_rate>
          <visualize>false</visualize>
          <topic>/depth_sensor</topic>
          <gz_frame_id>depth_sensor_link</gz_frame_id>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image><width>96</width><height>64</height></image>
            <clip><near>0.1</near><far>5.0</far></clip>
            <depth_camera><clip><near>0.1</near><far>5.0</far></clip></depth_camera>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>$(arg gz_depth_noise)</stddev>
            </noise>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:if value="${'$(arg gz_lidar)' == 'true'}">
      <link name="lidar_link"/>
      <joint name="lidar_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="lidar_link"/>
        <origin xyz="$(arg gz_lidar_xyz)" rpy="$(arg gz_lidar_rpy)"/>
      </joint>
      <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
          <always_on>true</always_on>
          <update_rate>$(arg gz_lidar_rate)</update_rate>
          <visualize>false</visualize>
          <topic>/scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <lidar>
            <scan>
              <horizontal>
                <samples>$(arg gz_lidar_samples)</samples>
                <resolution>1</resolution>
                <min_angle>$(arg gz_lidar_min_angle)</min_angle>
                <max_angle>$(arg gz_lidar_max_angle)</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>$(arg gz_lidar_min)</min>
              <max>$(arg gz_lidar_max)</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>$(arg gz_lidar_noise)</stddev>
            </noise>
          </lidar>
        </sensor>
      </gazebo>
    </xacro:if>

    <xacro:if value="${'$(arg gz_rgb_camera)' == 'true'}">
      <link name="rgb_camera_link"/>
      <joint name="rgb_camera_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="rgb_camera_link"/>
        <origin xyz="$(arg gz_rgb_xyz)" rpy="$(arg gz_rgb_rpy)"/>
      </joint>
      <gazebo reference="rgb_camera_link">
        <sensor name="rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>$(arg gz_rgb_rate)</update_rate>
          <visualize>false</visualize>
          <topic>/rgb_camera</topic>
          <gz_frame_id>rgb_camera_link</gz_frame_id>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov>
            <image><width>$(arg gz_rgb_width)</width><height>$(arg gz_rgb_height)</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>20.0</far></clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <link name="ft_sensor_link">
      <visual>
        <origin xyz="0 0 ${sensor_length / 2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${sensor_radius}" length="${sensor_length}"/></geometry>
        <material name="ft_sensor_dark"><color rgba="0.1 0.1 0.12 1"/></material>
      </visual>
      <inertial>
        <origin xyz="0 0 ${sensor_com_z}" rpy="0 0 0"/>
        <mass value="${sensor_mass}"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
    <joint name="ft_sensor_joint" type="fixed">
      <parent link="arm_flange_link"/>
      <child link="ft_sensor_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- A fixed joint is lumped into its parent by the URDF to SDF conversion unless it is
         preserved; the sensor needs the joint. -->
    <gazebo reference="ft_sensor_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <sensor name="ft_sensor" type="force_torque">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <topic>ft_sensor/wrench</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </gazebo>

    <!-- Keep the tool as its own link so its collision can carry the contact sensor. -->
    <gazebo reference="tool_mount_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>
    <gazebo reference="tool_mount_link">
      <mu1>${tool_mu}</mu1>
      <mu2>${tool_mu}</mu2>
    </gazebo>

    <!-- Compliant tool tip: the tool's collision lives on tool_tip_link, a side branch of tool_mount_link
         (not in the arm-to-tcp chain, so kinematics and the controller see the same rigid tcp) on a
         prismatic joint along the tool axis with a spring and a damper. The wall can only push it back
         (tool -z), up to tip_travel. Without it the contact is a rigid body on a servo joint: about
         108 N for any penetration of 0.05 mm or more, so no force loop can hold 10 N. -->
    <link name="tool_tip_link">
      <visual>
        <origin xyz="0 0 ${tip_length / 2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${tip_radius}" length="${tip_length}"/></geometry>
        <material name="tool_tip_orange"><color rgba="0.95 0.5 0.1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${tip_length / 2.0}" rpy="0 0 0"/>
        <geometry><cylinder radius="${tip_radius}" length="${tip_length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${tip_length / 2.0}" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00003"/>
      </inertial>
    </link>
    <!-- Bump stop: tool_tip_link hangs off a second, stiff and short prismatic stage in series behind the soft
         tip stage. Series springs add, so below the 20 mm travel the soft stage moves (the stiff one gives 0.1 mm
         at 5 N); once the soft stage sits on its joint limit (100 N) the stiff stage (stop_stiffness 50 N/mm,
         stop_damping, stop_travel 5 mm) takes over, so the force beyond the travel rises 50 N per mm of
         extra push and ends in a bounded ~350 N before the final rigid limit, not at the instant rigid wall
         the soft stage's joint limit alone is. -->
    <link name="tool_tip_stop_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.01"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
    <joint name="tool_tip_joint" type="prismatic">
      <parent link="tool_mount_link"/>
      <child link="tool_tip_stop_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-tip_travel}" upper="0.0" effort="1000" velocity="1.0"/>
      <dynamics damping="${tip_damping}" friction="0.0"/>
    </joint>
    <gazebo reference="tool_tip_joint">
      <implicitSpringDamper>true</implicitSpringDamper>
      <springStiffness>${tip_stiffness}</springStiffness>
      <springReference>0.0</springReference>
    </gazebo>
    <joint name="tool_tip_stop_joint" type="prismatic">
      <parent link="tool_tip_stop_link"/>
      <child link="tool_tip_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-stop_travel}" upper="0.0" effort="2000" velocity="1.0"/>
      <dynamics damping="${stop_damping}" friction="0.0"/>
    </joint>
    <gazebo reference="tool_tip_stop_joint">
      <implicitSpringDamper>true</implicitSpringDamper>
      <springStiffness>${stop_stiffness}</springStiffness>
      <springReference>0.0</springReference>
    </gazebo>
    <gazebo reference="tool_tip_link">
      <mu1>${tool_mu}</mu1>
      <mu2>${tool_mu}</mu2>
      <sensor name="tool_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <contact>
          <topic>/tool_contact/contacts</topic>
          <collision>tool_tip_link_collision</collision>
        </contact>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
