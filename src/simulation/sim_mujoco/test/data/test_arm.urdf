<?xml version="1.0"?>
<!-- Test robot: base, prismatic lift with one mimic stage, two revolute joints, tool mount, tcp. -->
<robot name="test_arm">
  <link name="base_link">
    <collision><geometry><box size="0.4 0.4 0.2"/></geometry></collision>
    <inertial><mass value="20"/><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="lift_link">
    <collision><origin xyz="0 0 0.1"/><geometry><cylinder radius="0.05" length="0.2"/></geometry></collision>
    <inertial><mass value="5"/><inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="stage_link">
    <inertial><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="link1">
    <collision><origin xyz="0.2 0 0"/><geometry><mesh filename="cube.stl" scale="2 1 1"/></geometry></collision>
    <inertial><origin xyz="0.2 0 0" rpy="0 0 0.5"/><mass value="3"/>
      <inertia ixx="0.05" iyy="0.1" izz="0.1" ixy="0.01" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="link2">
    <collision><origin xyz="0.15 0 0" rpy="0 1.5708 0"/><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial><mass value="2"/><inertia ixx="0.02" iyy="0.02" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="tool_mount_link">
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.04" length="0.1"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" iyy="0.001" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="tcp_link"/>
  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/><child link="lift_link"/><origin xyz="0 0 0.1"/><axis xyz="0 0 1"/>
    <limit lower="0" upper="0.5" effort="2000" velocity="0.2"/>
  </joint>
  <joint name="stage_joint" type="prismatic">
    <parent link="base_link"/><child link="stage_link"/><origin xyz="0 0.1 0.1"/><axis xyz="0 0 1"/>
    <limit lower="0" upper="0.25" effort="1000" velocity="1"/>
    <mimic joint="lift_joint" multiplier="0.5" offset="0"/>
  </joint>
  <joint name="joint1" type="revolute">
    <parent link="lift_link"/><child link="link1"/><origin xyz="0 0 0.2" rpy="0 0 0.3"/><axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="100" velocity="2"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/><origin xyz="0.4 0 0" rpy="0 0.2 0"/><axis xyz="0 1 0"/>
    <limit lower="-2" upper="2" effort="50" velocity="2"/>
  </joint>
  <joint name="tool_mount_joint" type="fixed">
    <parent link="link2"/><child link="tool_mount_link"/><origin xyz="0.3 0 0" rpy="0 1.5708 0"/>
  </joint>
  <joint name="tcp_joint" type="fixed">
    <parent link="tool_mount_link"/><child link="tcp_link"/><origin xyz="0 0 0.165"/>
  </joint>
</robot>
