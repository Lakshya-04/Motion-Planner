<!-- One prismatic tool carriage along +z with a force/torque site, a mimic follower, and a wall
     above it. The tool pushes along +z into the wall; the wall pushes back along -z. -->
<mujoco model="slide_wall">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <worldbody>
    <body name="carriage" pos="0 0 0" gravcomp="1">
      <joint name="slide" type="slide" axis="0 0 1" range="-0.5 0.5" damping="50" armature="1"/>
      <inertial pos="0 0 0" mass="2" diaginertia="0.01 0.01 0.01"/>
      <geom name="pad" type="box" size="0.05 0.05 0.02" pos="0 0 0.03"/>
      <site name="ft_site" size="0.01"/>
      <body name="follower" gravcomp="1">
        <joint name="slave" type="slide" axis="0 0 1" damping="50" armature="1"/>
        <inertial pos="0 0 0" mass="1" diaginertia="0.01 0.01 0.01"/>
      </body>
    </body>
    <geom name="wall" type="box" size="0.5 0.5 0.05" pos="0 0 0.30"/>
  </worldbody>
  <equality>
    <joint joint1="slave" joint2="slide" polycoef="0 0.5 0 0 0"/>
  </equality>
  <actuator>
    <position name="act_slide" joint="slide" kp="1000" kv="100" forcerange="-500 500"/>
  </actuator>
  <sensor>
    <force name="ft_force" site="ft_site"/>
    <torque name="ft_torque" site="ft_site"/>
  </sensor>
</mujoco>
