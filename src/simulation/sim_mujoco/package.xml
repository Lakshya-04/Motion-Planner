<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim_mujoco</name>
  <version>0.0.0</version>
  <description>
    MuJoCo 4.x simulation backend: a ros2_control SystemInterface (hardware:=mujoco) that steps a
    MuJoCo model, an MJCF generator from the robot URDF and profile, a wall world generator from the
    coverage planner's scene files, and headless launch files. The MuJoCo SDK is not bundled: set
    MUJOCO_ROOT to an extracted mujoco-4.x release (the plugin is skipped when it is not found).
  </description>
  <maintainer email="100lakshyaagarwal@gmail.com">Lakshya Agarwal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>mobile_manipulator_description</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ft_bridge_hardware</exec_depend>
  <exec_depend>ft_conditioner</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>mobile_manipulator_moveit_config</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>coverage_planner</exec_depend>
  <exec_depend>manipulation_manager</exec_depend>
  <exec_depend>motion_planner_moveit</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/sim_mujoco.xml"/>
  </export>
</package>
